#!/sbin/openrc-run
# Loger - auditoria do servidor (OpenRC: Alpine, Gentoo, Artix...)
# Instalar: cp dist/openrc/loger /etc/init.d/ && rc-update add loger boot

description="Loger - auditoria do servidor"
command="/usr/local/bin/loger"
command_args="daemon ${LOGER_OPTS}"
supervisor="supervise-daemon"
respawn_delay=2
respawn_max=0
error_log="/var/log/loger-daemon.err"
extra_started_commands="reload"

depend() {
	need localmount
	after bootmisc
	before sshd
}

start_pre() {
	# Herdado pelo supervise-daemon e pelo loger: o OOM killer deixa o Loger por último.
	echo -900 > /proc/self/oom_score_adj 2>/dev/null
	renice -n -5 $$ >/dev/null 2>&1
	return 0
}

reload() {
	ebegin "Recarregando a configuração do Loger"
	supervise-daemon "${RC_SVCNAME}" --signal HUP
	eend $?
}
